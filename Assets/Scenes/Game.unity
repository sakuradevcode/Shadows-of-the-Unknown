  duckingParameter: MusicVolume
  subtitleTextUI: {fileID: 2088243129}
  phrase1_Start: {fileID: 8300000, guid: 7c898edd9288f334993dff918561d0bb, type: 3}
  text1: "Estoy atrapado... Tiene que haber una salida. No puedo quedarme aqu\xED."
  phrase2_Enemies: {fileID: 8300000, guid: b10205f90cf5f594ebafa139091ffdbd, type: 3}
  text2: "Esos ruidos... hay algo ah\xED fuera. Mejor me mantengo alejado."
  phrase3_Book: {fileID: 8300000, guid: d3f6a6425e8460b4aa4ee9b9ba44a333, type: 3}
  text3: "\xA1La luz! ... Si enfoco el haz, creo que puedo conducirlas hacia atr\xE1s."
  phrase4_Truck: {fileID: 8300000, guid: 5cec61c5cd1935146b5d5ed747260696, type: 3}
  text4: "Ese cami\xF3n... Si logro llegar hasta all\xED, tal vez pueda escapar de
    esta pesadilla."
